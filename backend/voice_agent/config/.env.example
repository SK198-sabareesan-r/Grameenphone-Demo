# Copy this file to config/.env (same folder) and fill in the values. config/.env is git-ignored.
# This service has its own settings, separate from backend/config/.env used by the Copilot.

SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_DEFAULT_LANGUAGE=auto
SARVAM_TTS_LANGUAGE=bn-IN
# Leave empty to use the model's default speaker. bulbul:v4-flash uses persona IDs
# (e.g. simran_en_customer); bulbul:v3 uses names (e.g. shubh). They are not interchangeable.
SARVAM_TTS_SPEAKER=
SARVAM_TTS_SAMPLE_RATE=8000
SARVAM_STREAM_TYPE=fast

# Realtime STT (wss://api.sarvam.ai/speech-to-text-realtime/ws). Model comes from SARVAM_STT_MODEL.
# Language: a BCP-47 code (bn-IN, en-IN, ...) or auto. Takes precedence over SARVAM_DEFAULT_LANGUAGE.
SARVAM_STT_LANGUAGE_CODE=auto
SARVAM_STT_MODE=transcribe
SARVAM_STT_STREAM_TYPE=balanced
SARVAM_STT_ENCODING=linear16
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_ENDPOINTING=vad
SARVAM_STT_RETURN_TIMESTAMPS=true
# Optional realtime tuning
# SARVAM_STT_CHUNK_MS=100
# SARVAM_STT_CONNECT_TIMEOUT_S=10
# SARVAM_STT_KEEPALIVE_INTERVAL_S=20
# SARVAM_STT_MAX_RECONNECT_ATTEMPTS=3
# Optional overrides
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_REALTIME_WS_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
# SARVAM_REQUEST_TIMEOUT_S=30
# Legacy names SARVAM_MODEL and SARVAM_LANGUAGE are still read if the new ones are unset.

# Vobiz (Console > Settings > API). Placeholders only; put real values in .env.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_BASE_URL=https://api.vobiz.ai/api/v1
# Outbound caller ID: an active number owned by this Vobiz account, in E.164 format.
# Vobiz India rules: an Indian caller ID may only call destinations in India (media anchoring).
VOBIZ_CALLER_ID=+91XXXXXXXXXX
VOBIZ_REQUEST_TIMEOUT_S=15
# true = reject Vobiz webhooks with a missing/invalid HMAC signature. false = local debugging only.
VOBIZ_VALIDATE_SIGNATURE=true
# Joined to PUBLIC_BASE_URL (must be public https) to build the URLs Vobiz calls.
VOBIZ_ANSWER_WEBHOOK_PATH=/api/vobiz/answer
VOBIZ_HANGUP_WEBHOOK_PATH=/api/vobiz/hangup
# WebSocket path for the audio stream (server implemented in a later milestone).
VOBIZ_STREAM_WS_PATH=/ws/vobiz/stream
# Inbound audio format: audio/x-l16;rate=8000, audio/x-l16;rate=16000 or audio/x-mulaw;rate=8000
VOBIZ_INBOUND_CONTENT_TYPE=audio/x-l16;rate=16000

# WebSocket server. Auth mode: "query" (token in URL) or "start_event" (token via extraHeaders).
VOBIZ_WS_AUTH_MODE=query
VOBIZ_WS_MAX_CONNECTIONS=100
VOBIZ_WS_QUEUE_FRAMES=500
VOBIZ_WS_MAX_MESSAGE_BYTES=262144
VOBIZ_WS_START_TIMEOUT_S=10
VOBIZ_WS_IDLE_TIMEOUT_S=60
# Outbound playAudio chunk size in ms (Vobiz recommends 20-60).
VOBIZ_PLAYBACK_CHUNK_MS=20
VOBIZ_CHECKPOINT_TIMEOUT_S=30

# Vobiz -> Sarvam realtime STT (one Sarvam session per call). Off by default: no Sarvam connection.
# Requires SARVAM_API_KEY and valid SARVAM_STT_* settings (checked at startup). Do not enable together
# with VOBIZ_DEV_CAPTURE_ENABLED.
VOBIZ_SARVAM_STT_ENABLED=false
# Max wait for the final transcript after a call ends; time buffered audio gets to drain.
VOBIZ_SARVAM_STT_FINALIZE_TIMEOUT_S=2.0
VOBIZ_AUDIO_DRAIN_TIMEOUT_S=0.5

# Inbound AI voice conversation: spoken greeting, then STT -> Amazon Bedrock (Converse API) -> Sarvam TTS
# -> Vobiz playback. OFF by default. Requires VOBIZ_SARVAM_STT_ENABLED=true, SARVAM_API_KEY and a Bedrock
# inference profile. AWS credentials come from the standard AWS chain (env vars, SSO/profile, IAM role);
# do not put them here. IAM needs bedrock:InvokeModel on the inference profile and its underlying model(s).
# Set SARVAM_TTS_LANGUAGE (en-IN or bn-IN) and SARVAM_TTS_SPEAKER (valid for SARVAM_TTS_MODEL) too.
AI_CONVERSATION_ENABLED=false
BEDROCK_INFERENCE_PROFILE_ARN=
# Empty = AWS_DEFAULT_REGION, else the region inside the inference profile ARN.
AWS_REGION=
# BEDROCK_MAX_TOKENS=200
# BEDROCK_TEMPERATURE=0.3
# AI_LLM_TIMEOUT_S=12
# AI_TTS_TIMEOUT_S=10
# AI_HISTORY_MAX_MESSAGES=20
# AI_BARGE_IN_ENABLED=true
# AI_BARGE_IN_GRACE_MS=500

# Internal transcript event pipeline (M4.4). Bounded per-subscriber queues; finals are never silently
# dropped (partials are dropped first, finals use the reserve).
TRANSCRIPT_SUBSCRIBER_QUEUE_SIZE=256
TRANSCRIPT_FINAL_RESERVE=64
TRANSCRIPT_SUBSCRIBER_TIMEOUT_S=5
TRANSCRIPT_DRAIN_TIMEOUT_S=2
TRANSCRIPT_CALL_IDLE_CLOSE_S=30
TRANSCRIPT_MAX_SUBSCRIBERS_PER_CALL=16

# DEVELOPMENT ONLY: capture a few seconds of inbound audio from YOUR OWN test call to verify the
# inbound L16 byte order. Needs all three of APP_ENV=development, ENABLED=true and DESTINATION.
# Only calls placed via POST /api/vobiz/calls to DESTINATION are captured. Keep disabled otherwise.
APP_ENV=production
VOBIZ_DEV_CAPTURE_ENABLED=false
VOBIZ_DEV_CAPTURE_DESTINATION=
VOBIZ_DEV_CAPTURE_MAX_SECONDS=10
# Empty = per-user app-data directory outside the project (must be outside the project).
VOBIZ_DEV_CAPTURE_DIR=
VOBIZ_DEV_CAPTURE_RETENTION_HOURS=24

# Shared secret for our own protected routes (POST /api/vobiz/calls, header X-Internal-Token).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

PUBLIC_BASE_URL=
COPILOT_TRANSCRIPT_WEBHOOK_URL=

# Optional
LOG_LEVEL=INFO
