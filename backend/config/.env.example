# Copy this file to config/.env and fill in the values.
# config/.env is git-ignored. Never commit real credentials.

# ---- Server ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Only if the frontend runs on a different origin (comma separated). Empty is fine with the Vite proxy.
CORS_ORIGINS=
# FastAPI /docs and /openapi.json. Keep false outside local development (they need no login).
COPILOT_API_DOCS_ENABLED=false

# ---- Authentication ----
# Required. HMAC key for agent session tokens; login is refused while it is empty.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
COPILOT_SESSION_SECRET=
# Users file with scrypt password hashes. Empty = config/users.json (git-ignored).
# Add a user with: python -m scripts.hash_password --username tania --name "Tania" --role agent
COPILOT_USERS_FILE=
COPILOT_SESSION_TTL_MINUTES=480
# One-time ticket lifetime for the panel WebSocket, in seconds.
COPILOT_WS_TICKET_TTL_S=60
# Customer picker and "Reset demo data" in the panel. Keep false unless running a demo.
DEMO_CONTROLS_ENABLED=false

# ---- AWS (Bedrock + S3) ----
AWS_REGION=
# Leave the three keys empty on EC2 or when using an IAM role / `aws configure`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional. When set, call records are also uploaded here.
S3_BUCKET=
# Private bucket for call conversations and call records. Holds customers' original mobile numbers.
# Create it once with: python -m scripts.create_transcript_bucket. Finished calls go to calls/<mobile number>/<call id>.json,
# voice calls in progress to live/<call id>/. Leave COPILOT_RUNTIME_DIR and COPILOT_CONVERSATIONS_DIR empty: nothing is stored locally.
S3_TRANSCRIPT_BUCKET=
# Where the exported knowledge PDFs go in the bucket (scripts.export_pdfs --upload).
S3_KNOWLEDGE_PREFIX=knowledge/pdf
# DynamoDB tables are named <prefix>customers, <prefix>network-areas, <prefix>tickets, <prefix>calls,
# <prefix>packs and <prefix>gp-centres. They must exist in AWS_REGION before seeding.
DYNAMODB_TABLE_PREFIX=gp-copilot-
# Give up on a DynamoDB call after this many seconds.
DYNAMODB_TIMEOUT_S=4

# ---- Where the Copilot's data lives ----
# dynamodb: read and write the DynamoDB tables. files: use only the local JSON seed files (no AWS needed).
DATA_BACKEND=dynamodb
# When DynamoDB cannot be reached (for example expired AWS credentials), keep working from the local files.
# Anything written meanwhile stays in the local files only. GET /api/health shows when this is active.
DATA_FALLBACK_TO_FILES=true
# After a DynamoDB failure, wait this many seconds before trying it again.
DATA_RETRY_AFTER_S=30
# Inference profile ARNs (Bedrock > Inference profiles), e.g. arn:aws:bedrock:<region>:<account-id>:inference-profile/<id>
# FAST is used for live analysis and Ask Copilot. SUMMARY is used for the after-call note.
BEDROCK_INFERENCE_PROFILE_ARN_FAST=
BEDROCK_INFERENCE_PROFILE_ARN_SUMMARY=
# Bedrock Knowledge Base ID (not a secret). Console: Knowledge bases > your KB > Knowledge base ID.
BEDROCK_KB_ID=
BEDROCK_KB_TOP_K=5
# Seconds to wait for a Knowledge Base search before using the local articles.
BEDROCK_KB_TIMEOUT_S=4
# Extra model call (1 to 3 s) that turns the sentence into an English query. Off: keyword matching covers Banglish.
BEDROCK_KB_REWRITE_QUERY=false
BEDROCK_KB_REWRITE_TIMEOUT_S=3

# ---- Automatic lookup for each customer sentence ----
ASSIST_ENABLED=true
# Give up on the model after this many seconds and show the matching articles only.
ASSIST_TIMEOUT_S=8
ASSIST_MAX_ARTICLES=4

# ---- Demo behaviour ----
# Verified team phones mapped to demo customers: +<number>:<customer_id>,... for example +8801711111111:rahim
# Bangladesh numbers are 11 digits (01XXXXXXXXX). Indian numbers are 10 digits and may start with +91.
# The agent can confirm one of these numbers to load that customer's card.
DEMO_PHONE_MAP=
TICKET_START_NUMBER=10234
# Optional. Folder for call records and tickets. Empty = backend/data/runtime.
COPILOT_RUNTIME_DIR=
# Per-call conversation JSON files (M3). Empty = data/conversations (git-ignored).
COPILOT_CONVERSATIONS_DIR=
# Shared secret the voice agent sends in X-Internal-Token to /api/v1/internal/*. Must equal the voice
# agent's INTERNAL_API_TOKEN. Empty = those routes answer 503.
INTERNAL_API_TOKEN=

