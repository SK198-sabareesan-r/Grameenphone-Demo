# Copy this file to config/.env and fill in the values.
# config/.env is git-ignored. Never commit real credentials.

# ---- Server ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Public https URL Twilio can reach (ngrok or your EC2 domain). No trailing slash.
PUBLIC_BASE_URL=
# Only if the frontend runs on a different origin (comma separated). Empty is fine with the Vite proxy.
CORS_ORIGINS=

# ---- AWS (Bedrock + S3) ----
AWS_REGION=
# Leave the three keys empty on EC2 or when using an IAM role / `aws configure`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional. When set, call records are also uploaded here.
S3_BUCKET=
S3_PREFIX=copilot/calls
# Where the exported knowledge PDFs go in the bucket (scripts.export_pdfs --upload).
S3_KNOWLEDGE_PREFIX=knowledge/pdf
# DynamoDB tables are named <prefix>customers, <prefix>network-areas, <prefix>tickets, <prefix>calls,
# <prefix>packs and <prefix>gp-centres. They must exist in AWS_REGION before seeding.
DYNAMODB_TABLE_PREFIX=gp-copilot-
# Give up on a DynamoDB call after this many seconds.
DYNAMODB_TIMEOUT_S=4

# ---- Where the Copilot's data lives ----
# dynamodb: read and write the DynamoDB tables. files: use only the local JSON seed files (no AWS needed).
DATA_BACKEND=dynamodb
# When DynamoDB cannot be reached (for example expired AWS credentials), keep working from the local files.
# Anything written meanwhile stays in the local files only. GET /api/health shows when this is active.
DATA_FALLBACK_TO_FILES=true
# After a DynamoDB failure, wait this many seconds before trying it again.
DATA_RETRY_AFTER_S=30
# Inference profile ARNs (Bedrock > Inference profiles), e.g. arn:aws:bedrock:<region>:<account-id>:inference-profile/<id>
# FAST is used for live analysis and Ask Copilot. SUMMARY is used for the after-call note.
BEDROCK_INFERENCE_PROFILE_ARN_FAST=
BEDROCK_INFERENCE_PROFILE_ARN_SUMMARY=

# ---- Sarvam (STT + TTS) ----
SARVAM_API_KEY=
SARVAM_STT_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
# Optional. Leave empty to use Sarvam's default speech-to-text model.
SARVAM_STT_MODEL=
# bn-IN, en-IN or auto. Test on real Bangladeshi speech and pick one.
SARVAM_STT_LANGUAGE=bn-IN
# transcribe | codemix | translit | verbatim (applies to final transcripts)
SARVAM_STT_MODE=codemix
SARVAM_STT_STREAM_TYPE=fast
SARVAM_STT_SILENCE_MS=700
# Comma separated terms (max 50) that bias recognition.
SARVAM_STT_KEYTERMS=Grameenphone,MyGP,Skitto,bKash,Flexiplan,GP Star,roaming,Prime
SARVAM_STT_MAX_RETRIES=3
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
# Optional. Leave empty to use Sarvam's default text-to-speech model.
SARVAM_TTS_MODEL=
SARVAM_TTS_LANGUAGE=bn-IN
# Persona IDs from the Sarvam voice catalog (used by the replay script only).
SARVAM_TTS_SPEAKER_AGENT=
SARVAM_TTS_SPEAKER_CUSTOMER=

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App used by the browser softphone (Voice SDK).
TWILIO_TWIML_APP_SID=
TWILIO_AGENT_IDENTITY=agent
TWILIO_RECORD_CALLS=true
# Set to true once PUBLIC_BASE_URL is final. Rejects requests not signed by Twilio.
TWILIO_VALIDATE_SIGNATURE=false

# ---- Automatic lookup for each customer sentence ----
ASSIST_ENABLED=true
# Give up on the model after this many seconds and show the matching articles only.
ASSIST_TIMEOUT_S=8
ASSIST_MAX_ARTICLES=4

# ---- Demo behaviour ----
# Verified team phones mapped to demo customers: +<number>:<customer_id>,...
# The agent can confirm one of these numbers to load that customer's card.
DEMO_PHONE_MAP=
TICKET_START_NUMBER=10234

